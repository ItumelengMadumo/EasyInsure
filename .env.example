# Copy this file to .env and fill in real values. Never commit .env.

# ── Branding ── shown in the API title, root endpoint, and frontend UI
COMPANY_NAME=EasyInsure

# ── Environment ── "development" or "production"
ENVIRONMENT=development
# DEV_MODE=true bypasses ALL authentication (any login = superuser).
# Local dev only — the app refuses to start with DEV_MODE=true when ENVIRONMENT=production.
DEV_MODE=false

# ── Security ──
# Generate with: openssl rand -base64 48
SECRET_KEY=

# ── Database ── (used to build DATABASE_URL for the postgres container in docker-compose)
POSTGRES_DB=Insurance_llm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# To use an external managed Postgres instead of the bundled container,
# set DATABASE_URL directly and remove the "postgres" service from docker-compose.yml.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── LLM ──
OPENAI_API_KEY=

# ── CORS ── comma-separated list of allowed origins. Never "*".
CORS_ORIGINS=http://localhost
