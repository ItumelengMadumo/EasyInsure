{
  "name": "easyinsure-amplify",
  "private": true,
  "version": "3.0.0",
  "packageManager": "npm@10.9.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "sandbox": "ampx sandbox",
    "sandbox:once": "ampx sandbox --once",
    "sandbox:delete": "ampx sandbox delete",
    "typecheck": "tsc -b --pretty false",
    "check:region": "tsx scripts/assert-regional-boundary.ts",
    "verify": "npm run check:region && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-amplify/data-schema-types": "1.3.0",
    "@aws-amplify/ui-react": "6.15.4",
    "@aws-sdk/client-bedrock-runtime": "3.1092.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1092.0",
    "@aws-sdk/client-lambda": "3.1092.0",
    "@aws-sdk/client-sfn": "3.1092.0",
    "aws-amplify": "6.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xstate": "4.38.3"
  },
  "devDependencies": {
    "@aws-amplify/backend": "1.23.0",
    "@aws-amplify/backend-cli": "1.8.3",
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "22.19.7",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.4",
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.7.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "tsx": "4.23.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "overrides": {
    "@opentelemetry/core": "2.0.0"
  }
}
